{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open source building block for an AI software factory",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "url", "license", "category", "summary", "sources"],
  "properties": {
    "name": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "license": { "type": "string" },
    "category": { "enum": ["factory-platform", "workflow-engine", "triage", "spec", "context-store", "template"] },
    "summary": { "type": "string", "minLength": 20, "maxLength": 280 },
    "used_by": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "date": { "type": "string" }
        }
      }
    }
  }
}
